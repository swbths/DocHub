<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DocHub</AssemblyName>
    <RootNamespace>DocHub</RootNamespace>
    <AssemblyTitle>文枢</AssemblyTitle>
    <Product>文枢</Product>
    <Authors>AI</Authors>
    <Company>AI</Company>
    <Copyright>© 2026 AI · 软件构思 chao</Copyright>
    <Description>文枢 DocHub · 文档中枢，一键合转（Word / PDF / 图片 合并与 PDF 转图片）</Description>
    <Version>4.5.6</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- 自包含发布：安装包携带运行库，安装后的 DocHub.exe 仍是精简的启动器 -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="_test\**\*.cs" />
    <Compile Remove="tools\**\*.cs" />
    <Compile Remove="installer\**\*.cs" />
    <Compile Remove="build\**\*.cs" />
    <Compile Remove="dist\**\*.cs" />
  </ItemGroup>
</Project>
